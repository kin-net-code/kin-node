#!/usr/bin/env bash
set -Eeuo pipefail

fail() {
  printf 'FAIL  %s\n' "$*" >&2
  exit 1
}

tool_root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
trusted_base_box=kin/sanitized-ubuntu-26.04
trusted_base_version=20260823.0
base_receipt=/var/lib/kin-base-images/kin-sanitized-ubuntu-26.04.json

for required_command in git vagrant VBoxManage python3 find; do
  command -v "$required_command" >/dev/null 2>&1 || \
    fail "$required_command is required on the VM host"
done

verify_canonical_base() {
  local box_list versions vagrant_home version_dir verifier
  local -a provider_directories=()

  [[ ${KIN_NODE_BOX:-$trusted_base_box} == "$trusted_base_box" ]] || \
    fail "only the Canonical-derived Kin Ubuntu 26.04 base is permitted; no fallback is configured"
  [[ ${KIN_NODE_BOX_VERSION:-$trusted_base_version} == "$trusted_base_version" ]] || \
    fail "only Canonical base version $trusted_base_version is permitted; no fallback is configured"

  box_list=$(vagrant box list 2>&1) || {
    printf '%s\n' "$box_list" >&2
    fail "cannot inventory local Vagrant boxes"
  }
  versions=$(awk -v name="$trusted_base_box" '
    $1 == name {
      row=$0
      sub(/^[^(]*\(/, "", row)
      sub(/\)[[:space:]]*$/, "", row)
      split(row, fields, ",")
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", fields[1])
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", fields[2])
      if (fields[1] == "virtualbox") print fields[2]
    }
  ' <<<"$box_list")
  grep -Fxq "$trusted_base_version" <<<"$versions" || \
    fail "trusted base is absent: $trusted_base_box (virtualbox, $trusted_base_version); no fallback is configured"

  if [[ -n ${VAGRANT_HOME:-} ]]; then
    vagrant_home=$VAGRANT_HOME
  else
    [[ -n ${HOME:-} ]] || fail "HOME or VAGRANT_HOME is required"
    vagrant_home=$HOME/.vagrant.d
  fi
  version_dir="$vagrant_home/boxes/kin-VAGRANTSLASH-sanitized-ubuntu-26.04/$trusted_base_version"
  while IFS= read -r -d '' provider_directory; do
    provider_directories+=("$provider_directory")
  done < <(find "$version_dir" -mindepth 1 -maxdepth 2 -type d \
    -name virtualbox -print0 2>/dev/null)
  [[ ${#provider_directories[@]} -eq 1 ]] || \
    fail "trusted base provider directory is absent or ambiguous: $version_dir"

  verifier="$tool_root/host/verify_canonical_base.py"
  [[ -f "$verifier" && ! -L "$verifier" ]] || \
    fail "Canonical base verifier is absent"
  python3 -B "$verifier" "${provider_directories[0]}" \
    "$trusted_base_version" "$base_receipt" || \
    fail "Canonical base provenance rejected; no fallback is configured"
}

repo_root=$(git -C "$tool_root" rev-parse --show-toplevel 2>/dev/null) || \
  fail "run this command from a Git checkout"

git -C "$repo_root" diff --quiet || fail "checkout has unstaged changes"
git -C "$repo_root" diff --cached --quiet || fail "checkout has staged changes"
[[ -z "$(git -C "$repo_root" ls-files --others --exclude-standard)" ]] || \
  fail "checkout has untracked files"

source_branch=$(git -C "$repo_root" symbolic-ref --quiet --short HEAD) || \
  fail "deployment requires a named Git branch, not detached HEAD"
git -C "$repo_root" check-ref-format --branch "$source_branch" >/dev/null || \
  fail "source branch is not valid"
[[ "$source_branch" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$ ]] || \
  fail "source branch contains unsupported characters"
[[ "$source_branch" != *..* && "$source_branch" != */ && "$source_branch" != *//* ]] || \
  fail "source branch contains an unsafe path component"

source_commit=$(git -C "$repo_root" rev-parse --verify HEAD)
[[ "$source_commit" =~ ^[0-9a-f]{40}$ ]] || fail "cannot resolve an exact source commit"

origin_commit=$(git -C "$repo_root" rev-parse --verify "refs/remotes/origin/$source_branch" 2>/dev/null) || \
  fail "origin/$source_branch is absent; fetch or push the branch first"
[[ "$source_commit" == "$origin_commit" ]] || \
  fail "HEAD differs from origin/$source_branch; deploy only pushed GitHub state"

verify_canonical_base

bundle_dir=$(mktemp -d "${TMPDIR:-/tmp}/kin-node-source.XXXXXX")
source_bundle="$bundle_dir/kin-node-source.bundle"

cleanup() {
  if [[ -e "$source_bundle" ]]; then
    unlink -- "$source_bundle"
  fi
  if [[ -d "$bundle_dir" ]]; then
    rmdir -- "$bundle_dir" 2>/dev/null || true
  fi
}
trap cleanup EXIT

git -C "$repo_root" bundle create "$source_bundle" "refs/heads/$source_branch"
git -C "$repo_root" bundle verify "$source_bundle"

cd "$tool_root"
vagrant validate
vagrant up --provider=virtualbox
"$tool_root/tests/base-vm-acceptance.sh"

vagrant upload "$source_bundle" /tmp/kin-node-source.bundle
vagrant upload "$tool_root/scripts/guest-configure.sh" /tmp/kin-node-guest-configure.sh

guest_command="bash /tmp/kin-node-guest-configure.sh '$source_branch' '$source_commit'"
vagrant ssh --command "$guest_command"

printf 'PASS  VAGRANT_H1 vm=%s source=%s\n' \
  "${KIN_NODE_VM_NAME:-kin-node}" "$source_commit"
