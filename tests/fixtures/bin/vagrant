#!/usr/bin/env bash
set -Eeuo pipefail

: "${KIN_TEST_VAGRANT_LOG:?KIN_TEST_VAGRANT_LOG is required}"
printf '%s\n' "$*" >> "$KIN_TEST_VAGRANT_LOG"

case "${1:-}" in
  validate|up)
    ;;
  box)
    [[ "${2:-}" == list ]]
    printf '%s\n' "${KIN_TEST_VAGRANT_BOX_LIST:-kin/sanitized-ubuntu-26.04 (virtualbox, 20260823.0)}"
    ;;
  upload)
    [[ -f "${2:-}" ]]
    if [[ "${3:-}" == /tmp/kin-node-source.bundle ]]; then
      git bundle verify "$2" >/dev/null
    fi
    ;;
  ssh)
    [[ "${2:-}" == --command ]]
    ;;
  *)
    printf 'FAIL  unexpected mocked Vagrant action: %s\n' "${1:-}" >&2
    exit 1
    ;;
esac
